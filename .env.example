# Copy to .env and fill in. These two values are safe to ship in the app
# (the anon key only works within row-level security rules).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The In Crowd in-app purchases (RevenueCat public SDK keys; safe to ship).
# Leave empty until the store products exist: see docs/IN-CROWD-PURCHASES.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
