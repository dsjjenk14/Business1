# Nightly LIVERA database backup (SQLite .backup, safe while the server runs). Run by livera-backup.timer.
# Backups: /var/lib/livera/backups/world-YYYYMMDD-HHMMSS.db.gz, the newest 14 kept.
[Unit]
Description=LIVERA database backup
After=livera-server.service

[Service]
Type=oneshot
User=livera
Group=livera
ExecStart=/opt/livera/current/deploy/backup.sh nightly
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/livera
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
