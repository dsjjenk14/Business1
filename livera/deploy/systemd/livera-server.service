# LIVERA game server: the only authority (livera/CLAUDE.md rule 1). Installed by deploy/setup.sh.
# Listens on loopback only; browsers reach it through the gateway and Caddy (HTTPS).
# Settings: /etc/livera/server.env (LIVERA_MAX_PLAYERS, LIVERA_MAX_SCRIPTED).
[Unit]
Description=LIVERA game server
Documentation=https://github.com/dsjjenk14/Business1
After=network.target

[Service]
Type=simple
User=livera
Group=livera
Environment=LIVERA_MAX_PLAYERS=16
Environment=LIVERA_MAX_SCRIPTED=16
EnvironmentFile=-/etc/livera/server.env
# No --dev (no time skips) and no --test-payments on a public server. Registration is closed:
# the operator adds players with livera-add-player (livera_server --add-account).
ExecStart=/opt/livera/current/bin/livera_server --data /opt/livera/current/data --db /var/lib/livera/world.db --bind 127.0.0.1 --port 7777 --closed-registration --max-players ${LIVERA_MAX_PLAYERS} --max-scripted ${LIVERA_MAX_SCRIPTED}
# SIGTERM makes the server save and leave cleanly.
KillSignal=SIGTERM
TimeoutStopSec=60
# One descriptor per connection. The gateway caps connections in all (GATEWAY_MAX_CONNECTIONS, 256) and per
# address; this only gives the server headroom above that cap, it is not a substitute for it.
LimitNOFILE=65536
Restart=on-failure
RestartSec=5

# Hardening: the server only needs its database folder and loopback networking.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/livera
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
