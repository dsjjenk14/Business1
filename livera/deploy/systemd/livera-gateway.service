# LIVERA browser gateway: a WebSocket-to-TCP pipe (web/gateway/gateway.mjs). Installed by deploy/setup.sh.
# Caddy proxies https://<site>/ws to it; it opens one TCP connection to the game server per browser.
# Settings: /etc/livera/gateway.env (ALLOWED_ORIGINS=https://<site>, written by setup.sh).
[Unit]
Description=LIVERA WebSocket gateway
After=network.target livera-server.service
Wants=livera-server.service

[Service]
Type=simple
User=livera
Group=livera
Environment=NODE_ENV=production
Environment=LIVERA_HOST=127.0.0.1
Environment=LIVERA_PORT=7777
Environment=GATEWAY_HOST=127.0.0.1
Environment=GATEWAY_PORT=8080
EnvironmentFile=/etc/livera/gateway.env
WorkingDirectory=/opt/livera/current/web/gateway
ExecStart=/usr/bin/env node /opt/livera/current/web/gateway/gateway.mjs
Restart=on-failure
RestartSec=3

# Hardening (no MemoryDenyWriteExecute: Node's JIT needs it off).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
